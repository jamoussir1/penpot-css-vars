{
  "name": "penpot-css-vars",
  "version": "0.1.0",
  "description": "Penpot plugin: export library colors and typographies as CSS custom properties.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch & vite preview",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@penpot/plugin-styles": "1.4.2",
    "@penpot/plugin-types": "1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
